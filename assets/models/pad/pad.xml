<mujoco model="pad">
  <default>
    <default class="visual">
      <geom group="1" type="mesh" contype="0" conaffinity="0"/>
    </default>
    <default class="collision">
      <geom group="0" type="mesh" solref="0.01 1" solimp="0.99 0.99 0.01" margin="0.001" priority="1" friction="15 15 0.0001"/>
    </default>
  </default>
  <asset>
    <texture type="2d" name="basetex" file="base.png" />
    <material name="base" texture = "basetex" specular="0.5" shininess="0.5"/> <!-- rgba="0.800000 0.800000 0.800000 1.000000"/>-->
    <mesh file="pad.obj" name="pad"/>
    <mesh file="pad_collision_0.obj" name="pad_collision_0"/>
    <mesh file="pad_collision_1.obj" name="pad_collision_1"/>
  </asset>
  <worldbody>
    <body name="base" pos="0 0 0">
      <body name="object">
      <geom material="base" mesh="pad" class="visual"/>
      <geom mesh="pad_collision_0" rgba="1 0 0 0" class="collision"/>
      <geom mesh="pad_collision_1" rgba="1 0 0 0" class="collision"/>
      </body>
    </body>
  </worldbody>
</mujoco>
